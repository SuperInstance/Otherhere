{
  "id": "prop.tree",
  "version": "0.2.0",
  "description": "A tree of a known species: western hemlock, Sitka spruce, or yellow cedar cones; alder and salmonberry thickets; a generic broadleaf anywhere else. Species comes from a Fact when there is one (OSM taxon, a capture); otherwise it is imagined from the Town's forest character (its Essence), which falls back to the biome's mix — around Sitka, ~70% hemlock, ~25% spruce, ~5% cedar.",
  "appliesTo": ["tree"],
  "geometry": "position",
  "ops": [
    {
      "op": "let",
      "name": "species",
      "value": {
        "attr": "species",
        "default": {
          "op": "pick",
          "options": ["hemlock", "spruce", "cedar", "alder", "broadleaf"],
          "weights": [
            { "param": "@essence.forest.hemlock" },
            { "param": "@essence.forest.spruce" },
            { "param": "@essence.forest.cedar" },
            { "param": "@essence.forest.alder" },
            { "param": "@essence.forest.broadleaf" }
          ],
          "key": "species"
        }
      }
    },
    {
      "op": "let",
      "name": "h",
      "value": {
        "op": "if",
        "cond": { "op": "has", "attr": "height" },
        "then": { "attr": "height" },
        "else": {
          "op": "if",
          "cond": {
            "op": "eq",
            "args": [{ "param": "species" }, "hemlock"]
          },
          "then": { "op": "rand", "min": 14, "max": 30, "key": "h" },
          "else": {
            "op": "if",
            "cond": {
              "op": "eq",
              "args": [{ "param": "species" }, "spruce"]
            },
            "then": { "op": "rand", "min": 18, "max": 38, "key": "h" },
            "else": {
              "op": "if",
              "cond": {
                "op": "eq",
                "args": [{ "param": "species" }, "cedar"]
              },
              "then": { "op": "rand", "min": 9, "max": 18, "key": "h" },
              "else": {
                "op": "if",
                "cond": {
                  "op": "eq",
                  "args": [{ "param": "species" }, "alder"]
                },
                "then": { "op": "rand", "min": 5.5, "max": 10, "key": "h" },
                "else": {
                  "op": "if",
                  "cond": {
                    "op": "eq",
                    "args": [{ "param": "species" }, "salmonberry"]
                  },
                  "then": { "op": "rand", "min": 1.4, "max": 2.4, "key": "h" },
                  "else": { "op": "rand", "min": 4, "max": 8, "key": "h" }
                }
              }
            }
          }
        }
      }
    },
    {
      "op": "let",
