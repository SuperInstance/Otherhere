{
  "name": "otherhere",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @otherhere/edge --filter @otherhere/client dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "deploy": "pnpm --filter @otherhere/client build && pnpm --filter @otherhere/edge run deploy",
    "ingest": "pnpm --filter @otherhere/core exec tsx scripts/ingest.ts",
    "seed:dev": "curl -sS -X POST --data-binary @packages/core/test/fixtures/overpass-zurich.json http://localhost:8787/api/dev/blocks/881f8ed951fffff"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.12"
  }
}
